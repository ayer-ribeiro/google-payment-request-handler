{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/payment-method",
      "headers": [
        {
          "key": "Link",
          "value": "<https://payment-method-nine-tan.vercel.app/payment-method/payment-methodment-manifest.json>; rel=\"payment-method-manifest\""
        }
      ]
    },
    {
      "source": "/payment-method/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://payment-method-nine-tan.vercel.app/payment-method/payment-methodment-manifest.json>; rel=\"payment-method-manifest\""
        }
      ]
    },
    {
      "source": "/payment-method/payment-methodment-manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/x-payment-manifest" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
